{
  "name": "@agentcomms/core",
  "version": "0.15.2",
  "description": "Provider-neutral core for agent-communications: config, secret store, approvals, audit log and untrusted-content handling.",
  "type": "module",
  "license": "MIT",
  "author": "Criss Moldovan",
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crissmoldovan/agent-communications.git",
    "directory": "packages/core"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "bin": {
    "agentcomms": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_LICENSES"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --experimental-strip-types --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "dom-serializer": "^3.1.1",
    "domhandler": "^6.0.1",
    "html-to-text": "^10.0.1",
    "htmlparser2": "^12.0.0",
    "postal-mime": "^4.0.5",
    "zod": "catalog:"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "^2.1.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "@types/html-to-text": "^9.0.4"
  },
  "agentcomms": {
    "contract": 1,
    "channel": "core",
    "label": "agentcomms (core)",
    "binary": "agentcomms",
    "server": {
      "defaultName": "agentcomms",
      "npxPackage": "@agentcomms/core",
      "npxArgs": [
        "mcp"
      ]
    },
    "approve": "agentcomms approve",
    "skills": {
      "prefix": "comms-",
      "contract": "skills/_shared/contract-comms.md"
    }
  }
}
