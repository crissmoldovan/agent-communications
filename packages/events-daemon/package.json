{
  "name": "@agentcomms/events-daemon",
  "version": "0.35.0",
  "description": "The local event service for agent-communications: rules you approve deliver Gmail, Slack, Resend and WhatsApp events to a signed webhook, a local live stream or a dry-run log.",
  "type": "module",
  "license": "MIT",
  "author": "Criss Moldovan",
  "engines": {
    "node": ">=22.16.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crissmoldovan/agent-communications.git",
    "directory": "packages/events-daemon"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "bin": {
    "agent-events": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "laya-enablement-disclosures.json",
    "laya-manifest.json",
    "laya-runtime.json",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_LICENSES"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --import ../../test/helpers/loopback-seal-preload.mjs --experimental-strip-types --disable-warning=ExperimentalWarning --test \"test/**/*.test.ts\" test/laya-runtime-package.test.mjs"
  },
  "dependencies": {
    "@agentcomms/core": "workspace:*",
    "@agentcomms/events": "workspace:*",
    "@agentcomms/gmail": "workspace:*",
    "@agentcomms/resend": "workspace:*",
    "@agentcomms/slack": "workspace:*",
    "@agentcomms/whatsapp": "workspace:*"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "ajv": "8.20.0",
    "commander": "^15.0.0",
    "playwright": "1.64.1",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:"
  },
  "agentcommsPackage": {
    "kind": "service",
    "binary": "agent-events",
    "server": {
      "defaultName": "events",
      "entry": "src/mcp/server.ts",
      "factory": "createEventsMcpServer"
    },
    "operations": "src/operations",
    "skills": {
      "prefix": "agentcomms-",
      "contract": "skills/_shared/contract-events.md"
    }
  }
}
