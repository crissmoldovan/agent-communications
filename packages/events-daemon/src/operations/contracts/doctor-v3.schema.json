{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentcomms.local/events-doctor-v3.schema.json",
  "title": "Phase E2 event daemon doctor report",
  "type": "object",
  "required": [
    "schemaVersion",
    "owner",
    "switch",
    "lineages",
    "superseded",
    "points",
    "awaitingReapproval",
    "activationIntents",
    "sources",
    "recovery",
    "judgeBoundary",
    "judge",
    "whatsapp"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "doctor-v3"
    },
    "owner": {
      "$ref": "https://agentcomms.local/events-doctor-v1.schema.json#/$defs/owner"
    },
    "switch": {
      "$ref": "https://agentcomms.local/events-doctor-v1.schema.json#/$defs/switch"
    },
    "lineages": {
      "type": "array",
      "items": {
        "$ref": "https://agentcomms.local/events-doctor-v1.schema.json#/$defs/lineage"
      }
    },
    "superseded": {
      "type": "array",
      "items": {
        "$ref": "https://agentcomms.local/events-doctor-v1.schema.json#/$defs/superseded"
      }
    },
    "points": {
      "type": "array",
      "items": {
        "$ref": "https://agentcomms.local/events-doctor-v1.schema.json#/$defs/point"
      }
    },
    "awaitingReapproval": {
      "type": "array",
      "items": {
        "$ref": "https://agentcomms.local/events-doctor-v1.schema.json#/$defs/awaiting"
      }
    },
    "activationIntents": {
      "type": "array",
      "items": {
        "$ref": "https://agentcomms.local/events-doctor-v1.schema.json#/$defs/intent"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "https://agentcomms.local/events-doctor-v1.schema.json#/$defs/sourceHealth"
      }
    },
    "recovery": {
      "$ref": "https://agentcomms.local/events-doctor-v1.schema.json#/$defs/recovery"
    },
    "judgeBoundary": {
      "type": "array",
      "maxItems": 0
    },
    "whatsapp": {
      "type": "array",
      "items": {
        "$ref": "https://agentcomms.local/events-doctor-v1.schema.json#/$defs/whatsapp"
      }
    },
    "judge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kinds", "budget", "reservations", "holds", "laya"],
      "properties": {
        "kinds": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "state", "version"],
                "properties": {
                  "kind": {
                    "enum": ["typesafe", "local-endpoint"]
                  },
                  "state": {
                    "enum": ["disabled", "enabled"]
                  },
                  "version": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "oneOf": [
                  {
                    "properties": {
                      "state": {
                        "const": "disabled"
                      },
                      "version": {
                        "type": "null"
                      }
                    }
                  },
                  {
                    "properties": {
                      "state": {
                        "const": "enabled"
                      },
                      "version": {
                        "type": "integer",
                        "minimum": 1
                      }
                    }
                  }
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "state"],
                "properties": {
                  "kind": {
                    "const": "laya"
                  },
                  "state": {
                    "enum": ["disabled", "enabled", "unavailable"]
                  },
                  "version": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "code": {
                    "$ref": "https://agentcomms.local/laya-model-status-v1.schema.json#/$defs/unavailableCode"
                  }
                },
                "oneOf": [
                  {
                    "required": ["version"],
                    "not": {
                      "required": ["code"]
                    },
                    "properties": {
                      "state": {
                        "const": "disabled"
                      },
                      "version": {
                        "type": "null"
                      }
                    }
                  },
                  {
                    "required": ["version"],
                    "not": {
                      "required": ["code"]
                    },
                    "properties": {
                      "state": {
                        "const": "enabled"
                      },
                      "version": {
                        "type": "integer",
                        "minimum": 1
                      }
                    }
                  },
                  {
                    "required": ["code"],
                    "not": {
                      "required": ["version"]
                    },
                    "properties": {
                      "state": {
                        "const": "unavailable"
                      }
                    }
                  }
                ]
              }
            ]
          },
          "allOf": [
            {
              "contains": {
                "type": "object",
                "required": ["kind"],
                "properties": {
                  "kind": {
                    "const": "typesafe"
                  }
                }
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "required": ["kind"],
                "properties": {
                  "kind": {
                    "const": "local-endpoint"
                  }
                }
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "required": ["kind"],
                "properties": {
                  "kind": {
                    "const": "laya"
                  }
                }
              },
              "minContains": 1,
              "maxContains": 1
            }
          ]
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": ["activeVersion"],
          "properties": {
            "activeVersion": {
              "type": ["integer", "null"]
            }
          }
        },
        "reservations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["state", "count"],
            "properties": {
              "state": {
                "enum": ["reserved", "in-flight", "settled", "released"]
              },
              "count": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "holds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["count", "oldestCreatedAt", "nextExpiresAt"],
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 0
            },
            "oldestCreatedAt": {
              "type": ["integer", "null"]
            },
            "nextExpiresAt": {
              "type": ["integer", "null"]
            }
          }
        },
        "laya": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "manifestId",
            "runtimeLockDigest",
            "runtime",
            "model",
            "boundary",
            "failureCode",
            "bytesVerified",
            "totalBytes"
          ],
          "properties": {
            "state": {
              "$ref": "https://agentcomms.local/laya-model-status-v1.schema.json#/$defs/state"
            },
            "manifestId": {
              "anyOf": [
                {
                  "$ref": "https://agentcomms.local/laya-model-status-v1.schema.json#/$defs/manifestId"
                },
                {
                  "type": "null"
                }
              ]
            },
            "runtimeLockDigest": {
              "anyOf": [
                {
                  "$ref": "https://agentcomms.local/laya-model-status-v1.schema.json#/$defs/lockDigest"
                },
                {
                  "type": "null"
                }
              ]
            },
            "runtime": {
              "enum": ["absent", "installing", "installed"]
            },
            "model": {
              "enum": ["absent", "installing", "downloading", "ready", "failed", "removed"]
            },
            "boundary": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["status", "reason"],
                  "properties": {
                    "status": {
                      "const": "active"
                    },
                    "reason": {
                      "type": "null"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["status", "reason"],
                  "properties": {
                    "status": {
                      "const": "unavailable"
                    },
                    "reason": {
                      "$ref": "https://agentcomms.local/laya-model-status-v1.schema.json#/$defs/unavailableCode"
                    }
                  }
                }
              ]
            },
            "failureCode": {
              "anyOf": [
                {
                  "$ref": "https://agentcomms.local/laya-model-status-v1.schema.json#/$defs/failureCode"
                },
                {
                  "type": "null"
                }
              ]
            },
            "bytesVerified": {
              "type": "integer",
              "minimum": 0
            },
            "totalBytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  },
  "description": "E2's successor to doctor-v2: every v2 property, an empty judge boundary, Laya's real kind state and its content-free artifact entry. doctor-v1 and doctor-v2 stay frozen."
}
