{
  "name": "@agentcomms/gmail",
  "version": "0.3.0",
  "description": "Gmail for coding agents: the agent-gmail CLI, an MCP server and a library — search, read, analyse and draft across many inboxes, with sending gated by approval.",
  "type": "module",
  "license": "MIT",
  "author": "Criss Moldovan",
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crissmoldovan/agent-communications.git",
    "directory": "packages/gmail"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "bin": {
    "agent-gmail": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_LICENSES"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --experimental-strip-types --test \"test/**/*.test.ts\""
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "2.1.0"
  },
  "devDependencies": {
    "@agentcomms/core": "workspace:*",
    "@googleapis/gmail": "^22.0.0",
    "@googleapis/people": "^12.0.0",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@types/nodemailer": "^8.0.2",
    "commander": "^15.0.0",
    "google-auth-library": "^11.1.0",
    "nodemailer": "10.0.10",
    "p-retry": "^8.0.1",
    "zod": "catalog:"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1"
  }
}
