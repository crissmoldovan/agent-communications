{
  "name": "@agentcomms/events",
  "version": "0.15.2",
  "description": "The event catalogue, conditions and mapping templates of agent-communications' local event emission: isomorphic, with no I/O and no Node imports.",
  "type": "module",
  "license": "MIT",
  "author": "Criss Moldovan",
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crissmoldovan/agent-communications.git",
    "directory": "packages/events"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_LICENSES"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json && tsc -p test/tsconfig.json",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test \"test/**/*.test.ts\"",
    "verify:browser": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/verify-browser.mjs"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "playwright": "1.63.0",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "agentcommsPackage": {
    "kind": "library"
  },
  "agentcommsRelease": {
    "hold": "Held until the first package that depends on it ships; its first version is then published by hand (docs/RELEASING.md, A package held back from release)."
  }
}
