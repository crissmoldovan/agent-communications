{
  "name": "@agentcomms/whatsapp",
  "version": "0.15.0",
  "description": "WhatsApp for coding agents, read-only: list, read and search the chats WhatsApp for Mac keeps on this Mac, and draft replies as links the person sends. No network client; it never sends.",
  "type": "module",
  "license": "MIT",
  "author": "Criss Moldovan",
  "engines": {
    "node": ">=22.16.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crissmoldovan/agent-communications.git",
    "directory": "packages/whatsapp"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "bin": {
    "agent-whatsapp": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_LICENSES"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test --test-timeout=600000 \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@agentcomms/core": "workspace:*"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "commander": "^15.0.0",
    "zod": "catalog:"
  },
  "agentcomms": {
    "contract": 1,
    "channel": "whatsapp",
    "label": "WhatsApp",
    "binary": "agent-whatsapp",
    "server": {
      "defaultName": "whatsapp",
      "npxPackage": "@agentcomms/whatsapp",
      "npxArgs": [
        "mcp"
      ]
    },
    "accounts": {
      "map": "accounts",
      "noun": "account",
      "modes": [
        "read"
      ],
      "guarantee": {
        "ceiling": "code",
        "floor": "code",
        "why": "It reads only local files — a private copy of the store WhatsApp for Mac keeps on this Mac — and has no network client and no WhatsApp session, so it never sends: a draft is a link that opens WhatsApp with the text filled in, and the person presses send."
      }
    },
    "narrowing": [
      {
        "option": "account",
        "flag": "--account",
        "kind": "pin"
      }
    ],
    "rivals": {
      "word": "whatsapp",
      "can": "send WhatsApp messages as you"
    },
    "hosts": [],
    "approve": "agent-whatsapp approve",
    "skills": {
      "prefix": "whatsapp-",
      "contract": "skills/_shared/contract-whatsapp.md"
    }
  }
}
