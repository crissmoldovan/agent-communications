{
  "name": "@agentcomms/slack",
  "version": "0.15.0",
  "description": "Slack for coding agents: read channels, threads and search across workspaces, and draft messages nothing posts without a person.",
  "type": "module",
  "license": "MIT",
  "author": "Criss Moldovan",
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crissmoldovan/agent-communications.git",
    "directory": "packages/slack"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "bin": {
    "agent-slack": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_LICENSES"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --experimental-strip-types --test --test-timeout=600000 \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@agentcomms/core": "workspace:*"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "2.1.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "commander": "^15.0.0",
    "zod": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "agentcomms": {
    "contract": 1,
    "channel": "slack",
    "label": "Slack",
    "binary": "agent-slack",
    "server": {
      "defaultName": "slack",
      "npxPackage": "@agentcomms/slack",
      "npxArgs": [
        "mcp"
      ]
    },
    "accounts": {
      "map": "accounts",
      "noun": "workspace",
      "modes": [
        "read",
        "send"
      ],
      "guarantee": {
        "ceiling": "grant",
        "floor": "grant",
        "why": "A workspace connected to read holds a user token with no posting scope, so Slack itself refuses to post with it; one connected to send holds the scopes its app declares and no more."
      }
    },
    "narrowing": [
      {
        "option": "workspace",
        "flag": "--workspace",
        "kind": "pin"
      }
    ],
    "rivals": {
      "word": "slack",
      "can": "post to Slack"
    },
    "hosts": [
      "slack.com",
      "files.slack.com"
    ],
    "approve": "agent-slack approve",
    "approvalGrouping": "draft-revision-digest",
    "skills": {
      "prefix": "slack-",
      "contract": "skills/_shared/contract-slack.md"
    }
  }
}
