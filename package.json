{
  "name": "agent-communications",
  "version": "0.23.0",
  "private": true,
  "description": "Agent Skills, CLIs and MCP servers that let coding agents work with Gmail and Slack safely, across many mailboxes and workspaces.",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crissmoldovan/agent-communications.git"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "build": "pnpm -r --filter \"./packages/**\" --filter \"./apps/**\" run build",
    "typecheck": "pnpm -r --filter \"./packages/**\" --filter \"./apps/**\" run typecheck",
    "test": "node --import ./test/helpers/loopback-seal-preload.mjs --test \"test/**/*.test.mjs\" && pnpm -r --filter \"./packages/**\" --filter \"./apps/**\" run test",
    "lint": "biome ci .",
    "format": "biome format --write .",
    "verify:skills": "node scripts/sync-skills.mjs --check && node scripts/verify-skills.mjs",
    "sync:reference": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/sync-reference.mjs",
    "verify:reference": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/sync-reference.mjs --check",
    "sync:channels": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/sync-channels.mjs",
    "verify:channels": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/sync-channels.mjs --check",
    "sync:unicode": "node packages/events/scripts/unicode.mjs",
    "verify:unicode": "node packages/events/scripts/unicode.mjs --check",
    "verify:parity": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/parity.mjs",
    "verify": "pnpm lint && pnpm verify:channels && pnpm verify:unicode && pnpm build && pnpm verify:events-phase-e-prerequisites && pnpm verify:events-phase-e-tests && pnpm typecheck && pnpm test && pnpm verify:skills && pnpm verify:versions && pnpm verify:licenses && pnpm verify:reference && pnpm verify:parity --strict && pnpm verify:packages",
    "release": "pnpm verify:events-phase-e-prerequisites && pnpm verify:events-phase-e-tests && node scripts/release.mjs",
    "release:publish": "pnpm verify:events-phase-e-prerequisites && pnpm verify:events-phase-e-tests && node scripts/release.mjs --publish",
    "preverify:packages": "pnpm verify:events-phase-e-prerequisites && pnpm verify:events-phase-e-tests",
    "verify:packages": "node scripts/verify-package.mjs --all",
    "verify:events-phase-e-prerequisites": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/verify-events-phase-e-prerequisites.mjs",
    "verify:events-phase-e-tests": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/verify-events-phase-e-tests.mjs",
    "verify:browser": "pnpm --filter @agentcomms/events run verify:browser",
    "sync:skills": "node scripts/sync-skills.mjs",
    "sync:versions": "node scripts/sync-versions.mjs",
    "verify:versions": "node scripts/sync-versions.mjs --check",
    "licenses": "node scripts/third-party-licenses.mjs",
    "verify:licenses": "node scripts/third-party-licenses.mjs --check"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
