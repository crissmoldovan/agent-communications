{
  "name": "agent-communications",
  "version": "0.4.2",
  "private": true,
  "description": "Agent Skills, CLIs and MCP servers that let coding agents work with Gmail and Slack safely, across many mailboxes and workspaces.",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crissmoldovan/agent-communications.git"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" run build",
    "typecheck": "pnpm -r --filter \"./packages/**\" run typecheck",
    "test": "node --test \"test/**/*.test.mjs\" && pnpm -r --filter \"./packages/**\" run test",
    "lint": "biome ci .",
    "format": "biome format --write .",
    "verify:skills": "node scripts/sync-skills.mjs --check && node scripts/verify-skills.mjs",
    "sync:reference": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/sync-reference.mjs",
    "verify:reference": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/sync-reference.mjs --check",
    "verify:parity": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/parity.mjs",
    "verify": "pnpm lint && pnpm build && pnpm typecheck && pnpm test && pnpm verify:skills && pnpm verify:versions && pnpm verify:licenses && pnpm verify:reference && pnpm verify:parity --strict && pnpm verify:packages",
    "release": "node scripts/release.mjs",
    "release:publish": "node scripts/release.mjs --publish",
    "verify:packages": "node scripts/verify-package.mjs --all",
    "sync:skills": "node scripts/sync-skills.mjs",
    "sync:versions": "node scripts/sync-versions.mjs",
    "verify:versions": "node scripts/sync-versions.mjs --check",
    "licenses": "node scripts/third-party-licenses.mjs",
    "verify:licenses": "node scripts/third-party-licenses.mjs --check"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
