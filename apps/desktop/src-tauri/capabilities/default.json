{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window: Tauri's events, dragging the window by its header, and the app's thirteen commands. No plugin is granted: the app's plugins run from Rust.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "allow-installation",
    "allow-cli",
    "allow-open-in-terminal",
    "allow-copy-text",
    "allow-open-link",
    "allow-open-profile",
    "allow-get-settings",
    "allow-set-folders",
    "allow-set-login-item",
    "allow-updater-state",
    "allow-check-for-updates",
    "allow-install-update",
    "allow-take-deep-link"
  ]
}
