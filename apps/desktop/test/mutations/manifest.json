      "production": "pnpm-lock.yaml",
      "import": "../../../pnpm-lock.yaml",
      "mutation": {
        "file": "pnpm-lock.yaml",
        "find": "  apps/desktop:\n",
        "replace": "  apps/desktop-missing:\n"
      }
    },
