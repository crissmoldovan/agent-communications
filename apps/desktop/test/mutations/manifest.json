    {
      "id": "desktop-workspace-private",
      "group": "task-1",
      "test": "apps/desktop/test/workspace.test.mjs",
      "testName": "desktop is a private workspace member outside package publishing",
      "production": "apps/desktop/package.json",
      "import": "../package.json",
      "mutation": {
        "file": "apps/desktop/package.json",
        "find": "\"private\": true",
        "replace": "\"private\": false"
      }
    },
    {
      "id": "desktop-capability-settings-tracked",
      "group": "task-1",
      "test": "apps/desktop/test/workspace.test.mjs",
      "testName": "desktop labelled capability files are present and Git-visible",
      "production": ".gitignore",
      "import": "../../../.gitignore",
      "mutation": {
        "file": ".gitignore",
        "find": "!apps/desktop/src-tauri/capabilities/settings.json",
        "replace": "# settings capability unignore removed"
      }
    },
    {
