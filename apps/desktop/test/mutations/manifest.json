    {
      "id": "desktop-handler-order",
      "group": "task-2",
      "test": "apps/desktop/test/csp-navigation.test.mjs",
      "testName": "desktop-handler-order",
      "production": "apps/desktop/src-tauri/src/lib.rs",
      "import": "../src-tauri/src/lib.rs",
      "mutation": {
        "file": "apps/desktop/src-tauri/src/lib.rs",
        "find": "security::install_security_before_windows(app)?;\n            tray::install_tray(app)?;\n            WebviewWindowBuilder::new(app, \"settings\", WebviewUrl::App(\"settings.html\".into()))\n                .title(\"Settings\")\n                .on_navigation(|url| security::allow_window_navigation(\"settings\", url))\n                .on_new_window(|_, _| security::deny_new_window(\"settings\"))\n                .on_download(|_, _| security::deny_download(\"settings\"))\n                .build()?;",
        "replace": "tray::install_tray(app)?;\n            WebviewWindowBuilder::new(app, \"settings\", WebviewUrl::App(\"settings.html\".into()))\n                .title(\"Settings\")\n                .on_navigation(|url| security::allow_window_navigation(\"settings\", url))\n                .on_new_window(|_, _| security::deny_new_window(\"settings\"))\n                .on_download(|_, _| security::deny_download(\"settings\"))\n                .build()?;\n            security::install_security_before_windows(app)?;"
      }
