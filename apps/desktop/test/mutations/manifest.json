      "testName": "root verification reaches desktop build, typecheck, and unit tests",
      "production": "package.json",
      "import": "../../../package.json",
      "mutation": {
        "file": "package.json",
        "find": "    \"build\": \"pnpm -r --filter \\\"./packages/**\\\" --filter \\\"./apps/**\\\" run build\",",
        "replace": "    \"build\": \"pnpm -r --filter \\\"./packages/**\\\" run build\","
      }
    },
