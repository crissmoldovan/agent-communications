      "mutation": {
        "file": "package.json",
        "find": "    \"build\": \"pnpm -r --filter \\\"./packages/**\\\" --filter \\\"./apps/**\\\" run build\",",
        "replace": "    \"build\": \"pnpm -r --filter \\\"./packages/**\\\" run build\","
